# IBSng E
IBSNG_URL=http://127.0.0.1:1237
# Supported: ADMIN, NORMAL_USER, VOIP_USER, ANONYMOUS
IBS_AUTH_TYPE=ADMIN
IBS_AUTH_NAME=system
# Set either IBS_AUTH_PASS or IBS_AUTH_SESSION.
# Session mode is preferred for MCP deployments.
IBS_AUTH_PASS=
IBS_AUTH_SESSION=
IBS_ADDR=127.0.0.1
IBSNG_TIMEOUT_MS=15000

# MCP
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Optional bearer token for HTTP MCP
MCP_AUTH_TOKEN=
# Keep false unless raw method execution is explicitly needed.
IBSNG_ENABLE_RAW_CALL=false
